---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photos: ImageMetadata[];
  alt: string;
}

const { photos, alt } = Astro.props;
---

<div class="gallery">
  {
    photos.map((p, i) => (
      <a href={p.src} target="_blank" rel="noopener">
        <Image src={p} alt={`${alt}, photo ${i + 1}`} widths={[480, 960, 1600]} sizes="(max-width: 700px) 100vw, 33vw" loading="lazy" />
      </a>
    ))
  }
</div>

<style>
  .gallery { display: grid; gap: 8px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  .gallery a { display: block; overflow: hidden; background: var(--surface); }
  .gallery :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; transition: transform 0.3s; }
  .gallery a:hover :global(img) { transform: scale(1.03); }
</style>
