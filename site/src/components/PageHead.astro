---
interface Props {
  label: string;
  title: string;
}

const { label, title } = Astro.props;
---

<header class="head">
  <div class="wrap">
    <p class="label">{label}</p>
    <h1>{title}</h1>
    <div class="intro muted"><slot /></div>
  </div>
</header>

<style>
  .head { padding: clamp(40px, 8vw, 88px) 0 clamp(24px, 4vw, 40px); border-bottom: 1px solid var(--line); }
  .intro { max-width: 64ch; font-size: 1.05rem; }
</style>
