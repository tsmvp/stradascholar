---
import type { Video } from '../lib/content';
import { formatDate } from '../lib/content';
import { thumbUrl, watchUrl } from '../lib/links';

interface Props {
  video: Video;
  carName?: string;
}

const { video, carName } = Astro.props;
---

<a class="video" href={watchUrl(video.id)} target="_blank" rel="noopener">
  <span class="thumb">
    <img src={thumbUrl(video.id)} alt="" loading="lazy" width="1280" height="720" />
    <span class="play" aria-hidden="true">▶</span>
  </span>
  {carName && <span class="label">{carName}</span>}
  <span class="title">{video.data.title}</span>
  <span class="date">{formatDate(video.data.date)}</span>
</a>

<style>
  .video { display: block; color: var(--text); text-decoration: none; }
  .thumb { position: relative; display: block; overflow: hidden; background: var(--surface); }
  .thumb img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; transition: transform 0.3s; }
  .video:hover img { transform: scale(1.03); }
  .play {
    position: absolute;
    left: 12px;
    bottom: 12px;
    background: var(--m-red);
    color: #fff;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    font-size: 0.9rem;
  }
  .label { display: block; margin-top: 10px; }
  .title { display: block; margin-top: 6px; font-weight: 600; line-height: 1.3; }
  .date { display: block; color: var(--muted); font-size: 0.85rem; margin-top: 4px; }
</style>
