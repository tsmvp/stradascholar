---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PairList from '../components/PairList.astro';
import { getCars } from '../lib/content';

const cars = (await getCars()).filter((c) => c.data.setup.length);
---

<Base title="Fitment" description="Wheels, tires and suspension on each of Lucas's BMWs.">
  <PageHead label="Fitment" title="Wheels, tires & suspension">
    <p>What each car sits on, side by side.</p>
  </PageHead>
  <section class="section">
    <div class="wrap cols">
      {
        cars.map((car) => (
          <div class="col">
            <p class="label">{car.data.chassis}</p>
            <h3>
              <a href={`/builds/${car.id}/#setup`}>{car.data.year} {car.data.name}</a>
            </h3>
            <PairList items={car.data.setup} />
          </div>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .cols { display: grid; gap: 28px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .col { background: var(--surface); border: 1px solid var(--line); padding: 20px; }
  .col h3 a { color: inherit; text-decoration: none; }
</style>
